{
  "version": 2,
  "framework": null,
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/mobiles.html", "destination": "/deals.html", "permanent": true },
    { "source": "/mobiles", "destination": "/deals.html", "permanent": true }
  ],
  "rewrites": [
    { "source": "/collections/under-99", "destination": "/collections/under-99.html" },
    { "source": "/collections/under-199", "destination": "/collections/under-199.html" },
    { "source": "/collections/under-499", "destination": "/collections/under-499.html" },
    { "source": "/collections/loot-of-the-day", "destination": "/collections/loot-of-the-day.html" },
    { "source": "/collections/(.*)", "destination": "/collections/$1.html" },
    { "source": "/deal/(.*)", "destination": "/deal/$1.html" }
  ],
  "headers": [
    {
      "source": "/data/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=60, must-revalidate"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/(index.html|app.js|style.css)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=60, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*).(css|js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=60, must-revalidate"
        }
      ]
    }
  ]
}
